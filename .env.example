NODE_ENV=development
PORT=4000

# Railway injects this automatically when you attach a Postgres plugin —
# locally, point it at your own Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/smart_fridge

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5

SESSION_TTL_MINUTES=10

# One-time secret used to create the first ADMIN account via
# POST /api/auth/bootstrap-admin (or the "First time setup" link in /admin).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_BOOTSTRAP_SECRET=replace-with-a-long-random-string

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

CORS_ORIGIN=*

SMS_PROVIDER_API_KEY=
