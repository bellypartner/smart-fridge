// Salad Caffe Smart Fridge — Phase 1 schema
// Model: manual scan (no electronic lock), batch-level QR (not per-instance)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────

enum Role {
  KITCHEN
  ADMIN
}

// Staff accounts only now (ADMIN / KITCHEN). Customers don't log in —
// they're identified by name + phone captured at checkout, not a verified account.
model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String?
  passwordHash String?  // staff log in with phone + password now — OTP endpoints remain but are unused until SMS is wired up
  role         Role     @default(KITCHEN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@index([phone])
}

model OtpCode {
  id         String   @id @default(cuid())
  phone      String
  codeHash   String   // never store OTP in plaintext
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// Fridges
// ─────────────────────────────────────────────

model Fridge {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. FRIDGE-TECHNOPARK-001, printed as the fridge QR
  name        String
  location    String?
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  isActive    Boolean  @default(true)
  lastServicedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks      FridgeStock[]
  sessions    ShoppingSession[]
  orders      Order[]
  feedbacks   Feedback[]

  @@index([code])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  billingEmail String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  fridges   Fridge[]
}

// ─────────────────────────────────────────────
// Catalog — Category, Product (master), Batch (what the QR encodes)
// ─────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  products  Product[]
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  imageUrl      String?  // holds a base64 data URI — see admin.service.ts createProduct
  calories      Int?
  proteinG      Float?
  carbsG        Float?
  fatG          Float?
  description   String?
  weightGrams   Int?     // shown on the printed batch label
  mrp           Decimal  @db.Decimal(10, 2)
  sellingPrice  Decimal  @db.Decimal(10, 2)
  costPrice     Decimal? @db.Decimal(10, 2) // cost to make one unit — for COGS/margin reporting. Nullable: not every product will have this entered right away, and profitability reporting simply excludes what isn't costed rather than assuming zero.
  gstPercent    Decimal  @db.Decimal(5, 2) @default(0)
  shelfLifeHours Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batches       Batch[]

  @@index([sku])
  @@index([categoryId])
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  RECALLED
}

model Batch {
  id             String      @id @default(cuid())
  batchCode      String      @unique // auto-generated: <product code>-<DDMM> — see admin.service.ts / batchCode.ts. A batch is not fridge-specific — see totalQuantity below.
  productId      String
  product        Product     @relation(fields: [productId], references: [id])
  manufacturedAt DateTime
  expiresAt      DateTime    // auto-computed from manufacturedAt + Product.shelfLifeHours
  status         BatchStatus @default(ACTIVE)
  totalQuantity  Int?        // total units produced in this run — nullable so existing batches from before this field existed aren't broken. Allocation to fridges (FridgeStock.quantityAllocated, summed across all fridges for this batch) is capped against this when set; unset means uncapped, for backward compatibility.
  costPricePerUnit Decimal?  @db.Decimal(10, 2) // snapshotted from Product.costPrice at batch-creation time — same reasoning as OrderItem.unitPrice below: a later cost change shouldn't retroactively rewrite what a batch actually cost to make. Null if the product had no cost price set at the time.
  createdAt      DateTime    @default(now())

  stocks         FridgeStock[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([batchCode])
  @@index([productId])
}

// Stock of a given batch sitting in a given fridge right now.
// quantityAvailable = physically in the fridge and not yet held/sold
// quantityHeld      = currently in an active customer's cart (soft hold, released on expiry)
// quantitySold      = confirmed paid and taken
model FridgeStock {
  id                 String   @id @default(cuid())
  fridgeId           String
  fridge             Fridge   @relation(fields: [fridgeId], references: [id])
  batchId            String
  batch              Batch    @relation(fields: [batchId], references: [id])
  quantityAvailable  Int      @default(0)
  quantityHeld       Int      @default(0)
  quantitySold       Int      @default(0)
  quantityWasted     Int      @default(0) // set by the daily "close out" action — see admin.service.ts closeOutStock
  quantityAllocated  Int      @default(0) // immutable running total ever allocated (create/restock only) — the "made" figure; not touched by manual corrections or close-out, so it stays honest even after those
  updatedAt          DateTime @updatedAt

  @@unique([fridgeId, batchId])
  @@index([fridgeId])
}

// ─────────────────────────────────────────────
// Shopping session — one per fridge visit
// ─────────────────────────────────────────────

enum SessionStatus {
  ACTIVE
  CHECKED_OUT
  EXPIRED
  ABANDONED
}

// Anonymous — no login. Created the moment a customer opens the app for a
// fridge; the returned id is held client-side (localStorage) as the only
// "credential" needed to keep scanning into the same cart.
model ShoppingSession {
  id         String        @id @default(cuid())
  fridgeId   String
  fridge     Fridge        @relation(fields: [fridgeId], references: [id])
  status     SessionStatus @default(ACTIVE)
  startedAt  DateTime      @default(now())
  expiresAt  DateTime      // startedAt + 20 min, extended on each scan
  closedAt   DateTime?

  cartItems  CartItem[]
  order      Order?

  @@index([fridgeId, status])
  @@index([expiresAt])
}

model CartItem {
  id         String          @id @default(cuid())
  sessionId  String
  session    ShoppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  batchId    String
  batch      Batch           @relation(fields: [batchId], references: [id])
  quantity   Int             @default(1)
  unitPrice  Decimal         @db.Decimal(10, 2) // snapshot of Product.sellingPrice at scan time
  gstPercent Decimal         @db.Decimal(5, 2)  // snapshot at scan time
  addedAt    DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([sessionId, batchId])
  @@index([sessionId])
}

// ─────────────────────────────────────────────
// Orders / payments
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  EXPIRED
}

model Order {
  id                String      @id @default(cuid())
  sessionId         String      @unique
  session           ShoppingSession @relation(fields: [sessionId], references: [id])
  fridgeId          String
  fridge            Fridge      @relation(fields: [fridgeId], references: [id])
  customerName      String      // captured at checkout — no login, so this is the only identity on the order
  customerPhone     String      // captured at checkout, unverified (no OTP) — used for receipt/contact only
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  gstAmount         Decimal     @db.Decimal(10, 2)
  totalAmount       Decimal     @db.Decimal(10, 2)
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?     @unique
  refundAmount      Decimal?    @db.Decimal(10, 2) // set when status becomes REFUNDED — a manual record, not a live Razorpay refund API call (see admin.service.ts)
  refundedAt        DateTime?
  createdAt         DateTime    @default(now())
  paidAt            DateTime?

  items             OrderItem[]

  @@index([customerPhone])
  @@index([fridgeId])
  @@index([status])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batchId             String
  batch               Batch   @relation(fields: [batchId], references: [id])
  productNameSnapshot String
  quantity            Int
  unitPrice           Decimal @db.Decimal(10, 2)
  gstPercent          Decimal @db.Decimal(5, 2)

  @@index([orderId])
}

// ─────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// ─────────────────────────────────────────────
// Feedback — public, anonymous-by-default, nothing required
// ─────────────────────────────────────────────

model Feedback {
  id              String   @id @default(cuid())
  // Name is required going forward — enforced in feedback.schema.ts, not
  // here at the DB level, since making an already-nullable column NOT
  // NULL is risky against rows that may already exist from before this
  // requirement was added. New submissions always have one; old rows
  // (if any) may not.
  name            String?
  phone           String?  // optional — "if you want us to call, leave your number"
  fridgeId        String?  // which fridge's QR this came from, if the QR was fridge-scoped
  fridge          Fridge?  @relation(fields: [fridgeId], references: [id])

  // Food ratings, 1-5, all independently optional
  tasteRating     Int?
  quantityRating  Int?
  qualityRating   Int?
  recommendRating Int?     // "how likely are you to recommend us to someone else"
  foodSuggestion  String?  // short free-text

  // Deliberately separate from food — a different axis entirely (staff,
  // checkout experience, fridge cleanliness, etc.), not a sub-category of it
  serviceRating   Int?
  serviceComment  String?

  createdAt       DateTime @default(now())

  @@index([fridgeId])
  @@index([createdAt])
}

// Separate from fridge Feedback above — a subscription customer isn't
// scanning a physical QR at a location, and the question set is entirely
// different (delivery, results, packaging), so a shared polymorphic table
// would mostly be nullable fields that don't apply to either side.
model SubscriptionFeedback {
  id                   String   @id @default(cuid())
  name                 String   // mandatory — a real table, not backward-compat nullable, since this is a brand new model with no prior rows to worry about
  phone                String?  // optional — "if you want us to call, leave your number"

  satisfactionRating   Int?     // 1-5 — overall, "how satisfied with the subscription"
  onTimeDeliveryRating Int?
  goalsResultRating    Int?     // progress toward whatever goal they subscribed for
  foodQualityRating    Int?
  quantityRating       Int?
  packagingRating      Int?
  recommendRating      Int?     // "how much would you recommend us to a friend"

  suggestions          String?
  additionalRequest    String?
  favoriteMeals        String?

  createdAt            DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Expenses — month-end operating costs (rent, salaries, utilities, etc.)
// Deliberately separate from COGS/wastage: those feed Gross Profit,
// expenses here are the next layer down to Net Profit. See
// admin.service.ts getProfitability().
// ─────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  description String
  category    String?  // free-text — rent, salaries, utilities, marketing, etc.
  amount      Decimal  @db.Decimal(10, 2)
  incurredOn  DateTime // which month/date this expense belongs to, for period filtering — not necessarily when it was entered into the system
  createdAt   DateTime @default(now())

  @@index([incurredOn])
}
